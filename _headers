# Netlify / statisches Hosting — Video-Streaming & Caching
/*.mp4
  Content-Type: video/mp4
  Accept-Ranges: bytes
  Cache-Control: public, max-age=604800

/*.webm
  Content-Type: video/webm
  Accept-Ranges: bytes
  Cache-Control: public, max-age=604800

/*.mov
  Content-Type: video/quicktime
  Accept-Ranges: bytes
  Cache-Control: public, max-age=604800
